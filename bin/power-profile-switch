#!/bin/bash
# Custom power profile and refresh rate switcher for Evo laptops

action="${1-}"

# Auto-detect power source
if [[ -z $action || $action == "autodetect" ]]; then
  action=battery
  for ps in /sys/class/power_supply/*; do
    [[ -r $ps/online && -r $ps/type ]] || continue
    type=$(cat "$ps/type")
    [[ $type == "Mains" || $type == "USB" ]] || continue
    if [[ $(cat "$ps/online") == "1" ]]; then
      action=ac
      break
    fi
  done
fi

# Detect active Hyprland user and runtime dir
TARGET_USER=$(whoami)
[ "$TARGET_USER" = "root" ] && TARGET_USER="dev"
TARGET_UID=$(id -u "$TARGET_USER" 2>/dev/null || echo 1000)

# Switch power profiles and display refresh rates
case "$action" in
  ac)
    powerprofilesctl set performance 2>/dev/null || true
    
    # Switch screen refresh rate to 90Hz in Hyprland
    export HYPRLAND_INSTANCE_SIGNATURE=$(ls -1 /run/user/$TARGET_UID/hypr/ 2>/dev/null | grep -v "\.\." | head -n 1)
    if [[ -n $HYPRLAND_INSTANCE_SIGNATURE ]]; then
      export XDG_RUNTIME_DIR=/run/user/$TARGET_UID
      sudo -u "$TARGET_USER" -E hyprctl keyword monitor eDP-1,2880x1800@90,auto,2 >/dev/null 2>&1
    fi
    ;;
  battery)
    powerprofilesctl set power-saver 2>/dev/null || true
    
    # Switch screen refresh rate to 60Hz in Hyprland
    export HYPRLAND_INSTANCE_SIGNATURE=$(ls -1 /run/user/$TARGET_UID/hypr/ 2>/dev/null | grep -v "\.\." | head -n 1)
    if [[ -n $HYPRLAND_INSTANCE_SIGNATURE ]]; then
      export XDG_RUNTIME_DIR=/run/user/$TARGET_UID
      sudo -u "$TARGET_USER" -E hyprctl keyword monitor eDP-1,2880x1800@60,auto,2 >/dev/null 2>&1
    fi
    ;;
esac
