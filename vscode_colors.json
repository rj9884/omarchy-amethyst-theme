{
    "$schema": "vscode://schemas/color-theme",
    "name": "Omarchy Amethyst",
    "type": "dark",
    "colors": {
        "foreground": "#cdd6f4",
        "disabledForeground": "#585b70",
        "widget.shadow": "#11111b",
        "selection.background": "#585b70",
        "descriptionForeground": "#a6adc8",
        "errorForeground": "#f38ba8",
        "icon.foreground": "#cba6f7",

        "window.activeBorder": "#cba6f7",
        "button.background": "#cba6f7",
        "button.foreground": "#11111b",
        "button.hoverBackground": "#d4bff9",

        "editor.background": "#1e1e2e",
        "editor.foreground": "#cdd6f4",
        "editorLineNumber.foreground": "#585b70",
        "editorLineNumber.activeForeground": "#cba6f7",
        "editorCursor.foreground": "#cba6f7",
        "editor.selectionBackground": "#585b7060",
        "editor.lineHighlightBackground": "#313244",
        "editorIndentGuide.background": "#45475a",
        "editorIndentGuide.activeBackground": "#cba6f7",

        "activityBar.background": "#11111b",
        "activityBar.foreground": "#cba6f7",
        "activityBar.inactiveForeground": "#585b70",
        "activityBarBadge.background": "#cba6f7",
        "activityBarBadge.foreground": "#11111b",

        "sideBar.background": "#11111b",
        "sideBar.foreground": "#cdd6f4",
        "sideBarTitle.foreground": "#cba6f7",
        "sideBarSectionHeader.background": "#11111b",
        "sideBarSectionHeader.foreground": "#cdd6f4",

        "editorGroupHeader.tabsBackground": "#11111b",
        "tab.activeBackground": "#1e1e2e",
        "tab.activeForeground": "#cba6f7",
        "tab.inactiveBackground": "#11111b",
        "tab.inactiveForeground": "#585b70",
        "tab.activeBorder": "#cba6f7",

        "statusBar.background": "#11111b",
        "statusBar.foreground": "#cdd6f4",
        "statusBarItem.remoteBackground": "#cba6f7",
        "statusBarItem.remoteForeground": "#11111b",

        "terminal.background": "#1e1e2e",
        "terminal.ansiBlack": "#45475a",
        "terminal.ansiRed": "#f38ba8",
        "terminal.ansiGreen": "#cba6f7",
        "terminal.ansiYellow": "#f9e2af",
        "terminal.ansiBlue": "#89b4fa",
        "terminal.ansiMagenta": "#cba6f7",
        "terminal.ansiCyan": "#b4befe",
        "terminal.ansiWhite": "#cdd6f4",
        "terminal.ansiBrightBlack": "#585b70",
        "terminal.ansiBrightRed": "#f38ba8",
        "terminal.ansiBrightGreen": "#cba6f7",
        "terminal.ansiBrightYellow": "#fab387",
        "terminal.ansiBrightBlue": "#89b4fa",
        "terminal.ansiBrightMagenta": "#cba6f7",
        "terminal.ansiBrightCyan": "#b4befe",
        "terminal.ansiBrightWhite": "#a6adc8"
    },
    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {
                "foreground": "#585b70",
                "fontStyle": "italic"
            }
        },
        {
            "scope": "keyword",
            "settings": {
                "foreground": "#cba6f7"
            }
        },
        {
            "scope": "string",
            "settings": {
                "foreground": "#b4befe"
            }
        },
        {
            "scope": "entity.name.function",
            "settings": {
                "foreground": "#89b4fa"
            }
        },
        {
            "scope": "variable",
            "settings": {
                "foreground": "#cdd6f4"
            }
        }
    ]
}